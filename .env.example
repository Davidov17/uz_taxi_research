# Copy to .env and fill in real values. Never commit the real .env file
# (it's in .gitignore) — this file is the template, not a source of secrets.

# ---- Local (non-Docker) development ----------------------------------------
# Used directly by `uv run ...` commands on your own machine. Docker Compose
# ignores these two and builds its own DATABASE_URL from the POSTGRES_*
# variables below instead (see docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://baurjandavidov@localhost:5432/market_research_bot
TEST_DATABASE_URL=postgresql+asyncpg://baurjandavidov@localhost:5432/market_research_bot_test

# ---- Telegram ----------------------------------------------------------------
# Bot token from @BotFather. Required to run the bot (python -m
# telegram_bot.main); not required for migrations, the web dashboard, or tests.
BOT_TOKEN=

# ---- Docker Compose: Postgres container --------------------------------------
# Only read by the `postgres` service and by docker-compose.yml's DATABASE_URL
# interpolation for the bot/web/migrate services. Pick a real password for
# any non-throwaway deployment.
POSTGRES_USER=market_research_bot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=market_research_bot

# ---- Application configuration ------------------------------------------------
# Where uploaded screenshots are cached to disk. Inside Docker Compose this is
# fixed to /data/screenshots (a named volume) regardless of what's set here;
# this value only matters for local (non-Docker) runs.
SCREENSHOT_STORAGE_DIR=./data/screenshots

# debug | info | warning | error
LOG_LEVEL=INFO

# development | production — informational only (logged at startup), doesn't
# change behavior, but keep it accurate since it shows up in logs.
ENVIRONMENT=development

# Host port the dashboard is published on when running via Docker Compose
# (container always listens on 8000 internally).
WEB_PORT=8000

# ---- Webhook-mode deployment only (e.g. Render's free tier) ------------------
# Leave both blank for the normal docker-compose/long-polling setup — see
# docs/DEPLOYMENT.md's "Alternative: free-tier webhook deployment" section.
# Setting PUBLIC_BASE_URL is what switches main process from polling to
# webhook mode.
PUBLIC_BASE_URL=
WEBHOOK_SECRET=
